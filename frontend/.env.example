# Copy to .env.local. Never commit real secrets.

# operator-voting API (no trailing slash)
VITE_OPERATOR_VOTING_URL=http://127.0.0.1:3002

# Legal (terms evidence — not voting auth). No ADMIN_TOKEN here.
VITE_LEGAL_PROPERTY=vote.cl8y.com
VITE_LEGAL_API_BASE_URL=https://api.terms.cl8y.com
VITE_LEGAL_TERMS_BASE_URL=https://terms.cl8y.com
# Optional extra comma-separated redirect origins (portal allowlist remains authoritative)
# VITE_LEGAL_REDIRECT_ALLOWLIST=

# WalletConnect (Terra cosmes + EVM wagmi). Required for production builds (#12).
# Get a project id from cloud.walletconnect.com and allowlist https://vote.cl8y.com.
# VITE_WC_PROJECT_ID=

# Terra network for connect / signArbitrary: local | testnet | mainnet
VITE_NETWORK=mainnet
# VITE_TERRA_LCD_URL=https://terra-classic-lcd.publicnode.com
# VITE_TERRA_RPC_URL=https://terra-classic-rpc.publicnode.com:443

# Dev / LocalTerra only. Never prompt for a seed in the UI.
# VITE_DEV_MODE=true
# VITE_DEV_MNEMONIC=

# Playwright webServer only. Must stay unset on Coolify / production.
# VITE_PLAYWRIGHT_E2E=

# Do NOT add VITE_BSC_RPC or any VITE_* JSON-RPC for balance reads.
# The ledger / operator-voting owns eth_call and eth_getLogs.
