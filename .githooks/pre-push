#!/usr/bin/env bash
# Reject pushes whose commit message bodies contain emails or the word "author".
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=.githooks/lib/validate-commit-message.sh
source "${REPO_ROOT}/.githooks/lib/validate-commit-message.sh"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi
  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    range="$local_sha"
    commits=$(git rev-list "$local_sha" --not --all)
  else
    commits=$(git rev-list "${remote_sha}..${local_sha}")
  fi
  for hash in $commits; do
    tmp=$(mktemp)
    git log -1 --format='%B' "$hash" >"$tmp"
    if ! validate_commit_message "$tmp"; then
      rm -f "$tmp"
      echo "pre-push: REJECTED $hash" >&2
      exit 1
    fi
    rm -f "$tmp"
  done
done
